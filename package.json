{
  "name": "susan-ai",
  "version": "1.0.0",
  "description": "Susan - Jarvis-like AI Assistant with voice interaction",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "start:api": "node src/api/server.js",
    "start:websocket": "node src/api/services/StreamingService.js",
    "dev": "node --watch src/server.js",
    "dev:api": "node --watch src/api/server.js",
    "build": "echo 'Build completed - no compilation needed for Node.js'",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:api": "jest --testPathPattern=api",
    "test:voice": "jest --testPathPattern=voice",
    "test:websocket": "jest --testPathPattern=websocket",
    "test:performance": "jest --testPathPattern=performance",
    "test:security": "jest --testPathPattern=security",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=text-lcov --coverageReporters=html",
    "test:ci": "jest --ci --coverage --watchAll=false --maxWorkers=50%",
    "test:full": "npm run test:unit && npm run test:integration && npm run test:api && npm run test:e2e && npm run test:performance && npm run test:security && npm run test:voice && npm run test:websocket",
    "test:load": "artillery run tests/performance/load-test.yml",
    "test:ui": "node run-ui-tests.js",
    "test:ui:playwright": "npx playwright test",
    "test:ui:headed": "npx playwright test --headed",
    "test:ui:debug": "npx playwright test --debug",
    "test:spinning-issue": "npx playwright test tests/performance/spinning-issue-analysis.test.js",
    "test:upload-workflow": "npx playwright test tests/e2e/roofing-analysis-ui.test.js",
    "test:browser-compat": "npx playwright test tests/e2e/browser-compatibility.test.js",
    "test:accessibility": "npx playwright test tests/e2e/accessibility.test.js",
    "test:voice:setup": "node -e \"require('./tests/voice/enhanced-audio-processing.test.js')\"; echo 'Voice test setup completed'",
    "performance:report": "node tests/utils/comprehensive-test-reporter.js performance",
    "performance:compare": "echo 'Performance comparison not yet implemented'",
    "test:report:comprehensive": "node -e \"const { createTestReporter } = require('./tests/utils/comprehensive-test-reporter.js'); const reporter = createTestReporter(); reporter.generateAllReports().catch(console.error);\"",
    "test:report:nightly": "node -e \"const { createTestReporter } = require('./tests/utils/comprehensive-test-reporter.js'); const reporter = createTestReporter({ outputDir: 'reports/nightly' }); reporter.generateAllReports().catch(console.error);\"",
    "demo:video": "node video-generation-demo.js",
    "lint": "echo 'ESLint not configured - add eslint to devDependencies'",
    "format:check": "echo 'Prettier not configured - add prettier to devDependencies'",
    "docs:validate": "echo 'JSDoc validation not configured'",
    "setup": "npm install",
    "postinstall": "echo 'Installation completed successfully'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@tensorflow/tfjs-node": "^4.22.0",
    "axios": "^1.7.9",
    "canvas": "^3.2.0",
    "chalk": "^5.4.1",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exifr": "^7.1.3",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.2",
    "form-data": "^4.0.4",
    "fs-extra": "^11.2.0",
    "html2canvas": "^1.4.1",
    "image-js": "^1.0.0",
    "jimp": "^1.6.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^3.0.1",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.10.1",
    "openai": "^4.67.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "sharp": "^0.34.3",
    "tesseract.js": "^5.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.5",
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.40.1",
    "artillery": "^2.0.3",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-extended": "^4.0.2",
    "jest-mock-extended": "^3.0.5",
    "msw": "^2.0.11",
    "nock": "^13.5.0",
    "playwright": "^1.40.1",
    "puppeteer": "^21.11.0",
    "sinon": "^17.0.1",
    "supertest": "^6.3.4"
  },
  "keywords": [
    "ai",
    "assistant",
    "voice",
    "jarvis",
    "speech-recognition",
    "nlp"
  ],
  "author": "Susan AI Team",
  "license": "MIT"
}
