# Susan AI Comprehensive API Configuration

# Server Configuration
NODE_ENV=development
PORT=3001
HOST=localhost
LOG_LEVEL=info

# Security
JWT_SECRET=your-secret-key-change-this-in-production-use-long-random-string

# AI Provider API Keys
# Get OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Get Anthropic API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# API Key Authentication
# Add your API keys here (comma-separated)
VALID_API_KEYS=test-api-key-123,api-key-456,your-custom-api-key

# Admin API Keys (for administrative endpoints)
ADMIN_API_KEYS=admin-key-789,your-admin-api-key

# External Service API Keys (Optional)
# Weather API (e.g., OpenWeatherMap)
WEATHER_API_KEY=your-weather-api-key

# News API (e.g., NewsAPI.org)
NEWS_API_KEY=your-news-api-key

# Stock API (e.g., Alpha Vantage)
STOCK_API_KEY=your-stock-api-key

# AnythingLLM Configuration
# AnythingLLM API Key for vector database integration
ANYTHINGLLM_API_KEY=your-anythingllm-api-key-here

# AnythingLLM Base URL (local or cloud instance)
ANYTHINGLLM_BASE_URL=http://localhost:3001

# AnythingLLM Workspace (default workspace name for Susan AI)
ANYTHINGLLM_WORKSPACE=susan-ai

# AnythingLLM Request Timeout (in milliseconds)
ANYTHINGLLM_TIMEOUT=30000

# Auto-sync settings
ANYTHINGLLM_AUTO_SYNC=true
ANYTHINGLLM_SYNC_INTERVAL=300000
ANYTHINGLLM_BATCH_SIZE=10

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=52428800
MAX_FILES_PER_REQUEST=5

# Memory and Context Configuration
MAX_CONTEXT_DEPTH=50
MEMORY_CLEANUP_DAYS=90
MAX_SEARCH_RESULTS=100

# Plugin System Configuration
PLUGIN_TIMEOUT_MS=30000
MAX_PLUGIN_EXECUTION_TIME=60000

# Database Configuration (if using external database)
# DATABASE_URL=your-database-connection-string

# Redis Configuration (if using Redis for caching/rate limiting)
# REDIS_URL=redis://localhost:6379

# Monitoring and Analytics
# ANALYTICS_ENABLED=true
# MONITORING_ENDPOINT=your-monitoring-service-url