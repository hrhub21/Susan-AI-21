            },
            
            // Business Operations
            'customer-portal': {
                patterns: ['customer portal', 'client portal', 'customer dashboard', 'client access'],
                function: 'startCustomerPortal',
                description: 'Access customer portal features'
            },
            'schedule-manager': {
                patterns: ['schedule', 'appointment', 'calendar', 'booking', 'schedule work', 'schedule appointment'],
                function: 'startScheduleManager',
                description: 'Manage schedules and appointments'
            },
            'project-dashboard': {
                patterns: ['project dashboard', 'project status', 'project tracking', 'project management', 'job tracking'],
                function: 'startProjectDashboard',
                description: 'Track project progress and status'
            },
            
            // Weather & Safety
            'weather-alerts': {
                patterns: ['weather', 'weather alerts', 'storm alerts', 'weather conditions', 'forecast'],
                function: 'startWeatherAlerts',
                description: 'Get weather alerts and conditions'
            },
            'safety-protocols': {
                patterns: ['safety', 'safety protocols', 'safety procedures', 'safety check', 'safety guidelines'],
                function: 'startSafetyProtocols',
                description: 'Access safety protocols and procedures'
            },
            
            // Analytics & Intelligence
            'predictive-analytics': {
                patterns: ['analytics', 'predictive analytics', 'data analysis', 'predictions', 'trends', 'success rate'],
                function: 'startPredictiveAnalytics',
                description: 'View predictive analytics and insights'
            },
            'lead-scoring': {
                patterns: ['lead scoring', 'lead analysis', 'customer scoring', 'lead quality', 'prospect scoring'],
                function: 'startLeadScoring',
                description: 'Analyze and score leads'
            },
            
            // Help & Information
            'help-features': {
                patterns: ['help', 'what can you do', 'show features', 'available features', 'feature help', 'commands', 'what features', 'list features'],
                function: 'showFeatureHelp',
                description: 'Show all available conversational commands'
            }
        };
        
        // Check for exact matches first
        for (const [featureKey, featureData] of Object.entries(featurePatterns)) {
            for (const pattern of featureData.patterns) {
                if (inputLower.includes(pattern)) {
                    return {
                        key: featureKey,
                        function: featureData.function,
                        description: featureData.description,
                        confidence: this.calculatePatternConfidence(inputLower, pattern)
                    };
                }
            }
        }
        
        return null;
    }
    
    calculatePatternConfidence(input, pattern) {
        // Simple confidence scoring based on pattern match strength
        const exactMatch = input === pattern ? 1.0 : 0.8;
        const wordCount = pattern.split(' ').length;
        const inputWordCount = input.split(' ').length;
        
        // Higher confidence for more specific patterns
        return exactMatch * Math.min(1.0, wordCount / inputWordCount);
    }
    
    handleFeatureRequest(detectedFeature, originalInput) {
        try {
            console.log(`🎯 Detected feature request: ${detectedFeature.key} (${detectedFeature.confidence.toFixed(2)} confidence)`);
            
            // Add Susan's response explaining what she's doing
            const responseMessage = `I understand you want to ${detectedFeature.description.toLowerCase()}. Let me open that tool for you! 🚀`;
            this.addMessage(responseMessage, 'susan');
            
            // Execute the corresponding function
            if (typeof this[detectedFeature.function] === 'function') {
                // Add a slight delay to make it feel more natural
                setTimeout(() => {
                    this[detectedFeature.function]();
                    
                    // Add a follow-up message
                    setTimeout(() => {
                        this.addMessage(`The ${detectedFeature.description} tool is now open. You can also always access all features through the Advanced Features button (⊞) in the top navigation.`, 'susan');
                    }, 1000);
                }, 500);
            } else {
                console.error(`Function ${detectedFeature.function} not found`);
                this.addMessage(`I found the feature you're looking for, but there was an issue opening it. Please try using the Advanced Features button (⊞) in the navigation.`, 'susan');
            }
            
            // Log the successful feature detection for analytics
            this.addActivity(`Feature detected: ${detectedFeature.key}`, 'feature');
            
        } catch (error) {
            console.error('Error handling feature request:', error);
            this.addMessage(`I understand you want to ${detectedFeature.description.toLowerCase()}, but encountered an issue. You can access this feature through the Advanced Features button (⊞) in the navigation.`, 'susan');
        }
    }
    
    // ====== AUTO-TRIGGER & SUGGESTION SYSTEM ======
    
    suggestImageFeatures(filename, analysis) {
        setTimeout(() => {
            const suggestions = [];
            
            // Analyze the analysis results to suggest relevant features
            if (analysis.damageType && analysis.damageType !== 'No damage detected') {
                suggestions.push('💡 **Try asking me:** "quantify damage" to get detailed impact counts');
                suggestions.push('💡 **Or say:** "create estimate" to build a cost estimate for this damage');
                suggestions.push('💡 **You could ask:** "generate report" to create a professional documentation');
            }
            
            if (analysis.severity && (analysis.severity === 'High' || analysis.severity === 'Severe')) {
                suggestions.push('💡 **Consider:** "track claim" to start managing this insurance claim');
                suggestions.push('💡 **Ask me:** "insurance forms" to get the right paperwork started');
            }
            
            if (analysis.confidence > 80) {
                suggestions.push('💡 **Next steps:** "before after comparison" to document repair progress');
            }
            
            // Always suggest measurement tools for roofing photos
            suggestions.push('💡 **Helpful:** "measure roof" to calculate square footage and materials');
            suggestions.push('💡 **Smart idea:** "weather alerts" to check current conditions for this location');
            
            if (suggestions.length > 0) {
                const suggestionMessage = `📸 **Smart Suggestions for ${filename}:**\n\n` + 
                    suggestions.slice(0, 3).join('\n') + 
                    '\n\n✨ Just type any of these requests naturally - I\'ll understand and open the right tool!';
                
                this.addMessage(suggestionMessage, 'susan');
                this.addActivity(`Suggested features for ${filename}`, 'suggestion');
            }
        }, 2000); // Delay to let the analysis display first
    }
    
    suggestDocumentFeatures(filename, analysis) {
        setTimeout(() => {
            const suggestions = [];
            
            // Check document type for relevant suggestions
            if (analysis.analysis && analysis.analysis.documentType) {
                const docType = analysis.analysis.documentType.toLowerCase();
                
                if (docType.includes('insurance') || docType.includes('claim')) {
                    suggestions.push('💡 **Perfect match:** "claim tracking" to manage this claim');
                    suggestions.push('💡 **Try asking:** "insurance forms" to get additional required documents');
                    suggestions.push('💡 **Consider:** "policy analysis" to understand coverage details');
                }
                
                if (docType.includes('estimate') || docType.includes('invoice')) {
                    suggestions.push('💡 **Smart idea:** "estimate builder" to create or modify estimates');
                    suggestions.push('💡 **Ask me:** "material calculator" to verify material costs');
                }
                
                if (docType.includes('inspection') || docType.includes('report')) {
                    suggestions.push('💡 **Helpful:** "damage validation" to cross-reference findings');
                    suggestions.push('💡 **Consider:** "photo analysis" if you have related images');
                }
            }
            
            // General document suggestions
            suggestions.push('💡 **Always useful:** "documentation hub" to organize all your files');
            suggestions.push('💡 **Pro tip:** "contract generator" for professional agreements');
            
            if (suggestions.length > 0) {
                const suggestionMessage = `📄 **Smart Suggestions for ${filename}:**\n\n` + 
                    suggestions.slice(0, 3).join('\n') + 
                    '\n\n✨ Just ask me naturally - I understand conversational requests!';
                
                this.addMessage(suggestionMessage, 'susan');
                this.addActivity(`Suggested features for ${filename}`, 'suggestion');
            }
        }, 2000); // Delay to let the analysis display first
    }
    
    // Enhanced feature suggestion based on context
    suggestContextualFeatures(userInput, context = {}) {
        const inputLower = userInput.toLowerCase();
        const suggestions = [];
        
        // Context-aware suggestions based on conversation
        if (inputLower.includes('damage') && !inputLower.includes('quantify')) {
            suggestions.push('💡 Try: "quantify damage" for detailed impact analysis');
        }
        
        if (inputLower.includes('estimate') && !inputLower.includes('builder')) {
            suggestions.push('💡 Ask: "estimate builder" to create detailed estimates');
        }
        
        if (inputLower.includes('weather') || inputLower.includes('storm')) {
            suggestions.push('💡 Helpful: "weather alerts" for current conditions');
            suggestions.push('💡 Consider: "predictive analytics" for claim success rates');
        }
        
        if (inputLower.includes('customer') || inputLower.includes('client')) {
            suggestions.push('💡 Useful: "customer portal" for client communication');
            suggestions.push('💡 Try: "schedule manager" for appointments');
        }
        
        return suggestions;
    }
    
    provideContextualSuggestions(userInput, aiResponse) {
        // Don't provide suggestions too frequently - limit to every few messages
        if (!this.suggestionCounter) this.suggestionCounter = 0;
        this.suggestionCounter++;
        
        // Only suggest every 3rd conversation or when specific keywords are mentioned
        const shouldSuggest = this.suggestionCounter % 3 === 0 || 
                             this.containsActionableKeywords(userInput) ||
                             this.containsActionableKeywords(aiResponse);
        
        if (!shouldSuggest) return;
        
        setTimeout(() => {
            const suggestions = this.suggestContextualFeatures(userInput, { aiResponse });
            
            // Add additional suggestions based on AI response content
            const responseLower = aiResponse.toLowerCase();
            
            if (responseLower.includes('damage') || responseLower.includes('impact')) {
                suggestions.push('💡 **Pro tip:** Say "analyze photo" if you have damage images');
                suggestions.push('💡 **Helpful:** "quantify damage" for detailed measurements');
            }
            
            if (responseLower.includes('estimate') || responseLower.includes('cost') || responseLower.includes('price')) {
                suggestions.push('💡 **Smart:** "estimate builder" for professional estimates');
                suggestions.push('💡 **Useful:** "material calculator" for accurate pricing');
            }
            
            if (responseLower.includes('claim') || responseLower.includes('insurance')) {
                suggestions.push('💡 **Essential:** "claim tracking" to manage your claims');
                suggestions.push('💡 **Important:** "insurance forms" for proper documentation');
            }
            
            if (responseLower.includes('weather') || responseLower.includes('storm')) {
                suggestions.push('💡 **Current:** "weather alerts" for real-time conditions');
            }
            
            // Remove duplicates and limit suggestions
            const uniqueSuggestions = [...new Set(suggestions)];
            
            if (uniqueSuggestions.length > 0) {
                const suggestionMessage = `🤖 **I can help with more advanced tasks:**\n\n` + 
                    uniqueSuggestions.slice(0, 2).join('\n') + 
                    '\n\n💬 Just ask me naturally - I understand conversational requests and will open the right tools for you!';
                
                this.addMessage(suggestionMessage, 'susan');
                this.addActivity('Provided contextual suggestions', 'suggestion');
            }
        }, 3000); // Delay to let conversation flow naturally
    }
    
    containsActionableKeywords(text) {
        const actionableKeywords = [
            'damage', 'roof', 'photo', 'image', 'estimate', 'cost', 'price',
            'claim', 'insurance', 'weather', 'storm', 'hail', 'wind',
            'measurement', 'calculate', 'report', 'document', 'track',
            'schedule', 'appointment', 'customer', 'client', 'project'
        ];
        
        const textLower = text.toLowerCase();
        return actionableKeywords.some(keyword => textLower.includes(keyword));
    }
    
    // ====== END AUTO-TRIGGER & SUGGESTION SYSTEM ======
    
    handleServerMessage(data) {
        this.hideTypingIndicator();
        this.setThinkingState(false);
        
        switch (data.type) {
            case 'response':
                this.addMessage(data.content, 'susan');
                this.speakResponse(data.content);
                
                // Provide contextual feature suggestions after AI responds
                if (this.lastUserInput) {
                    this.provideContextualSuggestions(this.lastUserInput, data.content);
                }
                break;
            case 'connection':
                this.updateStatus(data.message || 'Connected to Susan AI');
                console.log('Connection status:', data.status);
                break;
            case 'status':
                this.updateStatus(data.content);
                break;
            case 'error':
                this.addMessage(`Error: ${data.content}`, 'susan');
                this.showNotification('Error', data.content, 'error');
                break;
            default:
                console.log('Unknown message type:', data.type, data);
        }
    }
    
    speakResponse(text) {
        if (!this.synthesis) {
            console.log('Speech synthesis not supported');
            return;
        }
        
        console.log('Speaking:', text);
        this.synthesis.cancel();
        
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.rate = this.settings.voiceSpeed;
        utterance.pitch = this.settings.voicePitch;
        utterance.volume = 0.8;
        
        const setVoice = () => {
            const voices = this.synthesis.getVoices();
            const femaleVoice = voices.find(voice => 
                voice.name.toLowerCase().includes('female') || 
                voice.name.toLowerCase().includes('woman') ||
                voice.name.toLowerCase().includes('zira') ||
                voice.name.toLowerCase().includes('hazel') ||
                voice.gender === 'female'
            );
            
            if (femaleVoice) {
                utterance.voice = femaleVoice;
            } else if (voices.length > 0) {
                utterance.voice = voices[0];
            }
        };
        
        utterance.onstart = () => {
            this.isSpeaking = true;
            this.susanOrb?.classList.add('speaking');
            this.updateStatus('Speaking');
        };
        
        utterance.onend = () => {
            this.isSpeaking = false;
            this.susanOrb?.classList.remove('speaking');
            this.updateStatus('Ready');
        };
        
        utterance.onerror = (event) => {
            console.error('Speech synthesis error:', event.error);
            this.isSpeaking = false;
            this.susanOrb?.classList.remove('speaking');
            
            if (event.error === 'not-allowed') {
                this.updateStatus('Speech blocked - click to enable');
                this.showNotification('Speech Blocked', 'Click anywhere to enable voice responses', 'warning');
                
                // Add click listener to enable speech
                const enableSpeech = () => {
                    console.log('Attempting to enable speech synthesis...');
                    document.removeEventListener('click', enableSpeech);
                    
                    // Try speaking a short test phrase to unlock
                    const testUtterance = new SpeechSynthesisUtterance('');
                    testUtterance.volume = 0; // Silent
                    this.synthesis.speak(testUtterance);
                    
                    setTimeout(() => {
                        this.updateStatus('Speech enabled - ready');
                        this.showNotification('Speech Enabled', 'Voice responses are now available', 'success');
                    }, 100);
                };
                
                document.addEventListener('click', enableSpeech, { once: true });
            } else {
                this.updateStatus(`Speech error: ${event.error}`);
                this.showNotification('Speech Error', `Voice output failed: ${event.error}`, 'error');
            }
        };
        
        const speak = () => {
            setTimeout(() => {
                this.synthesis.speak(utterance);
            }, 100);
        };
        
        if (this.synthesis.getVoices().length > 0) {
            setVoice();
            speak();
        } else {
            this.synthesis.addEventListener('voiceschanged', () => {
                setVoice();
                speak();
            }, { once: true });
            
            setTimeout(() => {
                if (this.synthesis.getVoices().length === 0) {
                    console.log('No voices loaded, speaking without voice selection');
                    this.synthesis.speak(utterance);
                }
            }, 1000);
        }
    }
    
    // Process markdown-style formatting for better display
    processMarkdown(text) {
        if (!text) return text;
        
        // Convert markdown to HTML
        return text
            // Bold text: **text** -> <strong>text</strong>
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
            // Italic text: *text* -> <em>text</em>
            .replace(/\*([^*]+)\*/g, '<em>$1</em>')
            // Convert line breaks to <br>
            .replace(/\n/g, '<br>')
            // Convert bullet points: • text -> proper list items
            .replace(/^• (.+)$/gm, '<span class="bullet-point">• $1</span>')
            // Convert numbers with periods: 1. text -> proper numbering
            .replace(/^(\d+\.) (.+)$/gm, '<span class="numbered-point">$1 $2</span>')
            // Clean up any triple asterisks that might remain
            .replace(/\*\*\*/g, '')
            // Handle emojis and special characters properly
            .replace(/💡\s*\*\*(.*?)\*\*/g, '💡 <strong>$1</strong>')
            .replace(/🎯\s*\*\*(.*?)\*\*/g, '🎯 <strong>$1</strong>')
            .replace(/📸\s*\*\*(.*?)\*\*/g, '📸 <strong>$1</strong>')
            .replace(/📊\s*\*\*(.*?)\*\*/g, '📊 <strong>$1</strong>');
    }
    
    addMessage(content, sender) {
        if (!this.chatContainer) return;
        
        const messageDiv = document.createElement('div');
        messageDiv.classList.add('message', sender);
        
        const timestamp = new Date();
        const timeString = this.formatTimestamp(timestamp);
        
        if (sender === 'user') {
            messageDiv.innerHTML = `
                <div class="message-avatar">
                    <div class="avatar-icon user-icon"></div>
                </div>
                <div class="message-content">
                    <div class="message-text">${content}</div>
                    <div class="message-time">${timeString}</div>
                </div>
            `;
        } else {
            // Process markdown formatting for Susan's messages
            const processedContent = this.processMarkdown(content);
            messageDiv.innerHTML = `
                <div class="message-avatar">
                    <div class="avatar-icon"></div>
                </div>
                <div class="message-content">
                    <div class="message-text">${processedContent}</div>
                    <div class="message-time">${timeString}</div>
                </div>
            `;
        }
        
        this.chatContainer.appendChild(messageDiv);
        this.chatContainer.scrollTop = this.chatContainer.scrollHeight;
    }
    
    showTypingIndicator() {
        this.typingIndicator?.classList.add('show');
    }
    
    hideTypingIndicator() {
        this.typingIndicator?.classList.remove('show');
    }
    
    setThinkingState(thinking) {
        this.isThinking = thinking;
        if (thinking) {
            this.susanOrb?.classList.add('thinking');
            this.updateStatus('Thinking...');
        } else {
            this.susanOrb?.classList.remove('thinking');
            if (!this.isListening && !this.isSpeaking) {
                this.updateStatus('Ready');
            }
        }
    }
    
    updateStatus(message) {
        if (this.statusText) {
            this.statusText.textContent = message;
        }
        console.log('Status:', message);
    }
    
    addActivity(text, type) {
        this.activityLog.unshift({
            text,
            type,
            timestamp: Date.now()
        });
        
        if (this.activityLog.length > this.maxActivityItems) {
            this.activityLog.pop();
        }
        
        this.updateActivityDisplay();
    }
    
    updateActivityDisplay() {
        if (!this.activityList) return;
        
        this.activityList.innerHTML = '';
        this.activityLog.forEach(activity => {
            const item = document.createElement('div');
            item.className = 'activity-item';
            item.innerHTML = `
                <div class="activity-icon ${activity.type}"></div>
                <div class="activity-content">
                    <div class="activity-text">${activity.text}</div>
                    <div class="activity-time">${this.timeAgo(activity.timestamp)}</div>
                </div>
            `;
            this.activityList.appendChild(item);
        });
    }
    
    showNotification(title, message, type = 'info') {
        const notification = {
            id: ++this.notificationId,
            title,
            message,
            type,
            timestamp: Date.now()
        };
        
        this.notifications.unshift(notification);
        this.displayNotification(notification);
        
        // Auto-remove after 5 seconds
        setTimeout(() => {
            this.removeNotification(notification.id);
        }, 5000);
    }
    
    displayNotification(notification) {
        if (!this.notificationContainer) return;
        
        const notificationDiv = document.createElement('div');
        notificationDiv.className = `notification ${notification.type}`;
        notificationDiv.id = `notification-${notification.id}`;
        notificationDiv.innerHTML = `
            <div class="notification-header">
                <strong>${notification.title}</strong>
                <button class="notification-close" onclick="susan.removeNotification(${notification.id})">×</button>
            </div>
            <div class="notification-message">${notification.message}</div>
        `;
        
        this.notificationContainer.appendChild(notificationDiv);
        
        // Animate in
        setTimeout(() => {
            notificationDiv.classList.add('show');
        }, 10);
    }
    
    removeNotification(id) {
        const notificationDiv = document.getElementById(`notification-${id}`);
        if (notificationDiv) {
            notificationDiv.classList.remove('show');
            setTimeout(() => {
                notificationDiv.remove();
            }, 300);
        }
        
        this.notifications = this.notifications.filter(n => n.id !== id);
    }
    
    // Initialize other methods with simplified implementations
    initTheme() {
        document.documentElement.setAttribute('data-theme', this.currentTheme);
    }
    
    initAudioVisualization() {
        // Simplified audio visualization
        console.log('Audio visualization initialized');
    }
    
    initDashboardWidgets() {
        console.log('Initializing dashboard widgets...');
        this.initWeatherWidget();
        this.initSystemMonitoring();
        this.updateAIStatusWidget();
    }

    async initWeatherWidget() {
        console.log('Initializing weather widget...');
        
        // Try to get user's location
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                (position) => {
                    this.fetchWeatherData(position.coords.latitude, position.coords.longitude);
                },
                (error) => {
                    console.log('Geolocation error:', error);
                    // Fallback to default location (New York)
                    this.fetchWeatherData(40.7128, -74.0060);
                }
            );
        } else {
            // Fallback to default location if geolocation not supported
            this.fetchWeatherData(40.7128, -74.0060);
        }
        
        // Set up refresh button
        const refreshBtn = document.querySelector('.weather-widget .widget-refresh');
        if (refreshBtn) {
            refreshBtn.addEventListener('click', () => {
                this.refreshWeatherData();
            });
        }
    }

    async fetchWeatherData(lat, lon) {
        try {
            // Use a free weather API (OpenWeatherMap) - you would need an API key
            // For demo purposes, I'll use mock data that looks realistic
            this.updateWeatherWidget(this.getMockWeatherData());
            
            // Uncomment this section if you have an OpenWeatherMap API key:
            /*
            const API_KEY = 'your_openweathermap_api_key_here';
            const response = await fetch(
                `https://api.openweathermap.org/data/2.5/weather?lat=${lat}&lon=${lon}&appid=${API_KEY}&units=metric`
            );
            
            if (response.ok) {
                const data = await response.json();
                this.updateWeatherWidget({
                    temperature: Math.round(data.main.temp),
                    description: data.weather[0].description,
                    humidity: data.main.humidity,
                    windSpeed: Math.round(data.wind.speed * 3.6), // Convert m/s to km/h
                    location: data.name
                });
            } else {
                throw new Error('Weather API request failed');
            }
            */
        } catch (error) {
            console.error('Weather fetch error:', error);
            this.updateWeatherWidget(this.getMockWeatherData());
        }
    }

    getMockWeatherData() {
        // Generate realistic mock weather data
        const conditions = [
            { desc: 'Clear sky', temp: 22, humidity: 45, wind: 8 },
            { desc: 'Few clouds', temp: 18, humidity: 55, wind: 12 },
            { desc: 'Scattered clouds', temp: 16, humidity: 65, wind: 15 },
            { desc: 'Partly cloudy', temp: 20, humidity: 50, wind: 10 },
            { desc: 'Overcast', temp: 14, humidity: 70, wind: 18 }
        ];
        
        const randomCondition = conditions[Math.floor(Math.random() * conditions.length)];
        
        return {
            temperature: randomCondition.temp,
            description: randomCondition.desc,
            humidity: randomCondition.humidity,
            windSpeed: randomCondition.wind,
            location: 'Current Location'
        };
    }

    updateWeatherWidget(data) {
        const temperatureElement = document.querySelector('.weather-widget .temperature');
        const descriptionElement = document.querySelector('.weather-widget .weather-desc');
        const humidityElement = document.querySelector('.weather-widget .humidity');
        const windElement = document.querySelector('.weather-widget .wind-speed');
        
        if (temperatureElement) {
            temperatureElement.textContent = `${data.temperature}°`;
        }
        
        if (descriptionElement) {
            descriptionElement.textContent = data.description;
        }
        
        if (humidityElement) {
            humidityElement.textContent = `${data.humidity}% humidity`;
        }
        
        if (windElement) {
            windElement.textContent = `${data.windSpeed} km/h wind`;
        }
        
        console.log('Weather widget updated:', data);
        this.addActivity(`Weather updated: ${data.temperature}°C, ${data.description}`, 'system');
    }

    refreshWeatherData() {
        console.log('Refreshing weather data...');
        this.showNotification('Weather', 'Refreshing weather data...', 'info');
        
        // Get current location again or use cached coordinates
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(
                (position) => {
                    this.fetchWeatherData(position.coords.latitude, position.coords.longitude);
                },
                () => {
                    // Fallback to mock data
                    this.fetchWeatherData(40.7128, -74.0060);
                }
            );
        } else {
            this.fetchWeatherData(40.7128, -74.0060);
        }
    }

    initSystemMonitoring() {
        // Update system performance metrics
        setInterval(() => {
            this.updateSystemMetrics();
        }, 5000); // Update every 5 seconds
    }

    updateSystemMetrics() {
        // Simulate system metrics
        const cpuUsage = Math.floor(Math.random() * 30) + 40; // 40-70%
        const memoryUsage = Math.floor(Math.random() * 20) + 55; // 55-75%
        
        const cpuElement = document.querySelector('.system-widget .cpu-fill');
        const cpuValueElement = document.querySelector('.system-widget .stat-item:first-child .stat-value');
        const memoryElement = document.querySelector('.system-widget .memory-fill');
        const memoryValueElement = document.querySelector('.system-widget .stat-item:nth-child(2) .stat-value');
        
        if (cpuElement && cpuValueElement) {
            cpuElement.style.width = `${cpuUsage}%`;
            cpuValueElement.textContent = `${cpuUsage}%`;
        }
        
        if (memoryElement && memoryValueElement) {
            memoryElement.style.width = `${memoryUsage}%`;
            memoryValueElement.textContent = `${memoryUsage}%`;
        }
    }

    updateAIStatusWidget() {
        // Update AI status metrics
        const responseTimeElement = document.querySelector('.ai-status-widget .metric-row:first-child .metric-value');
        const accuracyElement = document.querySelector('.ai-status-widget .metric-row:nth-child(2) .metric-value');
        
        if (responseTimeElement) {
            const responseTime = (Math.random() * 2 + 1).toFixed(1); // 1.0-3.0s
            responseTimeElement.textContent = `${responseTime}s`;
        }
        
        if (accuracyElement) {
            const accuracy = (Math.random() * 2 + 98).toFixed(1); // 98.0-100.0%
            accuracyElement.textContent = `${accuracy}%`;
        }
    }
    
