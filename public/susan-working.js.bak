    initFeaturesMenu() {
        console.log('Initializing advanced features menu...');
        
        const featuresMenu = document.getElementById('featuresMenu');
        const featuresOverlay = document.getElementById('featuresOverlay');
        const closeFeaturesBtn = document.getElementById('closeFeaturesBtn');
        
        if (!featuresMenu) {
            console.log('Features menu element not found');
            return;
        }
        
        // Close features menu
        if (closeFeaturesBtn) {
            console.log('✅ Binding close button event');
            closeFeaturesBtn.addEventListener('click', () => {
                console.log('Close features button clicked');
                this.hideFeaturesMenu();
            });
        } else {
            console.log('❌ Close features button not found');
        }
        
        if (featuresOverlay) {
            console.log('✅ Binding overlay click event');
            featuresOverlay.addEventListener('click', () => {
                console.log('Features overlay clicked');
                this.hideFeaturesMenu();
            });
        } else {
            console.log('❌ Features overlay not found');
        }
        
        // Keyboard shortcut
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !featuresMenu.classList.contains('hidden')) {
                console.log('Escape key pressed - closing features menu');
                this.hideFeaturesMenu();
            }
        });
        
        // Ensure the features menu starts hidden
        if (featuresMenu) {
            featuresMenu.classList.add('hidden');
            featuresMenu.setAttribute('aria-hidden', 'true');
        }
        
        console.log('✅ Features menu initialized');
        
        // Test the features button immediately
        this.testFeaturesButton();
    }
    
    testFeaturesButton() {
        console.log('🧪 Testing features button...');
        const featuresBtn = document.getElementById('featuresBtn');
        const featuresMenu = document.getElementById('featuresMenu');
        
        if (featuresBtn) {
            console.log('✅ Features button found');
            console.log('Button attributes:', {
                id: featuresBtn.id,
                'aria-expanded': featuresBtn.getAttribute('aria-expanded'),
                'aria-controls': featuresBtn.getAttribute('aria-controls'),
                disabled: featuresBtn.disabled
            });
        } else {
            console.log('❌ Features button NOT found');
        }
        
        if (featuresMenu) {
            console.log('✅ Features menu found');
            console.log('Menu attributes:', {
                id: featuresMenu.id,
                classes: featuresMenu.className,
                'aria-hidden': featuresMenu.getAttribute('aria-hidden'),
                display: getComputedStyle(featuresMenu).display
            });
        } else {
            console.log('❌ Features menu NOT found');
        }
    }
    
    showFeaturesMenu() {
        console.log('Attempting to show features menu...');
        const featuresMenu = document.getElementById('featuresMenu');
        const featuresBtn = document.getElementById('featuresBtn');
        
        if (featuresMenu) {
            console.log('✅ Features menu found, removing hidden class');
            featuresMenu.classList.remove('hidden');
            featuresMenu.setAttribute('aria-hidden', 'false');
            if (featuresBtn) {
                featuresBtn.setAttribute('aria-expanded', 'true');
                console.log('✅ Features button aria-expanded set to true');
            }
            
            // Focus management
            setTimeout(() => {
                const firstButton = featuresMenu.querySelector('.feature-btn');
                if (firstButton) {
                    firstButton.focus();
                    console.log('✅ Focus set to first feature button');
                }
            }, 100);
            
            console.log('✅ Features menu should now be visible');
        } else {
            console.log('❌ Features menu element not found');
        }
    }
    
    hideFeaturesMenu() {
        console.log('Attempting to hide features menu...');
        const featuresMenu = document.getElementById('featuresMenu');
        const featuresBtn = document.getElementById('featuresBtn');
        
        if (featuresMenu) {
            console.log('✅ Features menu found, adding hidden class');
            featuresMenu.classList.add('hidden');
            featuresMenu.setAttribute('aria-hidden', 'true');
            if (featuresBtn) {
                featuresBtn.setAttribute('aria-expanded', 'false');
                featuresBtn.focus();
                console.log('✅ Features button aria-expanded set to false and focused');
            }
            console.log('✅ Features menu should now be hidden');
        } else {
            console.log('❌ Features menu element not found');
        }
    }
    
