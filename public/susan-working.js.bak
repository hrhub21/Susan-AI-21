class SusanAI {
    constructor() {
        this.recognition = null;
        this.synthesis = window.speechSynthesis;
        this.isListening = false;
        this.isSpeaking = false;
        this.isThinking = false;
        this.ws = null;
        
        // Audio visualization
        this.audioContext = null;
        this.analyser = null;
        this.microphone = null;
        this.audioCanvas = null;
        this.canvasCtx = null;
        this.animationId = null;
        
        // Enhanced features
        this.mediaRecorder = null;
        this.audioChunks = [];
        
        // Theme and settings
        this.currentTheme = localStorage.getItem('susan-theme') || 'dark';
        this.settings = {
            voiceSpeed: parseFloat(localStorage.getItem('susan-voice-speed')) || 1.0,
            voicePitch: parseFloat(localStorage.getItem('susan-voice-pitch')) || 1.0,
            animationsEnabled: localStorage.getItem('susan-animations') !== 'false',
            particlesEnabled: localStorage.getItem('susan-particles') !== 'false'
        };
        
        // Activity tracking
        this.activityLog = [];
        this.maxActivityItems = 10;
        
        // Notification system
        this.notifications = [];
        this.notificationId = 0;
        
        console.log('🔄 Starting Susan AI initialization...');
        
        try {
            console.log('1/8 Initializing elements...');
            this.initElements();
            
            console.log('2/8 Initializing theme...');
            this.initTheme();
            
            console.log('3/8 Initializing audio visualization...');
            this.initAudioVisualization();
            
            console.log('4/8 Initializing speech recognition...');
            this.initSpeechRecognition();
            
            console.log('5/8 Initializing WebSocket...');
            this.initWebSocket();
            
            console.log('6/8 Binding events...');
            this.bindEvents();
            
            console.log('6.5/8 Setting up speech synthesis unlock...');
            this.setupSpeechSynthesisUnlock();
            
            console.log('7/8 Initializing features menu...');
            this.initFeaturesMenu();
            
            console.log('8/8 Initializing dashboard widgets...');
            this.initDashboardWidgets();
            
            console.log('8/8 Starting performance monitoring...');
            this.startPerformanceMonitoring();
            
            console.log('✅ Susan AI initialized successfully');
            
            // Hide loading screen
            this.hideLoadingScreen();
            
            // Safe activity and notification calls
            try {
                this.addActivity('System initialized', 'system');
            } catch (e) {
                console.log('Note: Activity logging not available');
            }
            
            try {
                this.showNotification('Welcome to Susan AI', 'System ready for interactions', 'success');
            } catch (e) {
                console.log('Note: Notifications not available');
            }
            
        } catch (error) {
            console.error('❌ Susan AI initialization failed:', error);
            throw error;
        }
    }
    
    initElements() {
        // Core elements
        this.susanOrb = document.getElementById('susanOrb');
        this.statusText = document.getElementById('statusText');
        this.statusIndicator = document.getElementById('statusIndicator');
        
        // Controls
        this.voiceBtn = document.getElementById('voiceBtn');
        this.stopBtn = document.getElementById('stopBtn');
        this.sendBtn = document.getElementById('sendBtn');
        this.attachBtn = document.getElementById('attachBtn');
        this.fileInput = document.getElementById('fileInput');
        
        // Chat and communication
        this.chatContainer = document.getElementById('chatContainer');
        this.typingIndicator = document.getElementById('typingIndicator');
        this.textInput = document.getElementById('textInput');
        
        // Navigation and settings
        this.themeToggle = document.getElementById('themeToggle');
        this.settingsBtn = document.getElementById('settingsBtn');
        this.settingsPanel = document.getElementById('settingsPanel');
        this.closeSettings = document.getElementById('closeSettings');
        this.fullscreenBtn = document.getElementById('fullscreenBtn');
        this.clearChat = document.getElementById('clearChat');
        
        // Audio visualization
        this.audioCanvas = document.getElementById('audioCanvas');
        this.voiceVisualizer = document.getElementById('voiceVisualizer');
        this.canvasCtx = this.audioCanvas?.getContext('2d');
        
        // Widgets and activity
        this.weatherWidget = document.getElementById('weatherWidget');
        this.systemWidget = document.getElementById('systemWidget');
        this.aiStatusWidget = document.getElementById('aiStatusWidget');
        this.activityList = document.getElementById('activityList');
        this.notificationContainer = document.getElementById('notificationContainer');
        
        // Drop zone
        this.dropZone = document.getElementById('dropZone');
        
        // Settings controls
        this.voiceSpeedSlider = document.getElementById('voiceSpeed');
        this.voicePitchSlider = document.getElementById('voicePitch');
        this.animationsToggle = document.getElementById('animationsToggle');
        this.particlesToggle = document.getElementById('particlesToggle');
    }
    
    initSpeechRecognition() {
        if (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window)) {
            this.updateStatus('Speech recognition not supported in this browser');
            this.voiceBtn.disabled = true;
            this.showNotification('Speech Recognition', 'Not supported in this browser', 'warning');
            return;
        }
        
        const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
        this.recognition = new SpeechRecognition();
        
        this.recognition.continuous = true;
        this.recognition.interimResults = true;
        this.recognition.lang = 'en-US';
        
        this.recognition.onstart = () => {
            this.isListening = true;
            this.updateStatus('Listening');
            this.susanOrb.classList.add('listening');
            this.voiceBtn.innerHTML = `
                <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                    <line x1="12" y1="19" x2="12" y2="23"/>
                    <line x1="8" y1="23" x2="16" y2="23"/>
                </svg>
                <span class="btn-text">Listening...</span>
            `;
            this.voiceBtn.disabled = true;
            this.addActivity('Voice interaction started', 'voice');
            this.startAudioVisualization();
        };
        
        this.recognition.onresult = (event) => {
            let finalTranscript = '';
            let interimTranscript = '';
            
            for (let i = event.resultIndex; i < event.results.length; i++) {
                const transcript = event.results[i][0].transcript;
                if (event.results[i].isFinal) {
                    finalTranscript += transcript;
                } else {
                    interimTranscript += transcript;
                }
            }
            
            if (finalTranscript) {
                this.processUserInput(finalTranscript.trim());
                this.addActivity(`Voice: "${finalTranscript.substring(0, 30)}..."`, 'voice');
            }
        };
        
        this.recognition.onerror = (event) => {
            console.error('Speech recognition error:', event.error);
            
            // Don't show error for "aborted" - this is normal when user stops
            if (event.error === 'aborted') {
                console.log('Speech recognition was aborted (normal)');
                return;
            }
            
            // Handle specific errors
            if (event.error === 'not-allowed') {
                this.updateStatus('Microphone access denied');
                this.showNotification('Microphone Access', 'Please allow microphone access in your browser', 'warning');
            } else if (event.error === 'no-speech') {
                this.updateStatus('No speech detected');
                this.showNotification('Speech Recognition', 'No speech was detected. Try speaking louder.', 'warning');
            } else {
                this.updateStatus(`Speech error: ${event.error}`);
                this.showNotification('Speech Recognition Error', `Failed: ${event.error}`, 'error');
            }
            
            this.stopListening();
        };
        
        this.recognition.onend = () => {
            this.stopListening();
        };
    }
    
    initWebSocket() {
        const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
        const wsUrl = `${protocol}//${window.location.host}`;
        
        this.ws = new WebSocket(wsUrl);
        
        this.ws.onopen = () => {
            console.log('WebSocket connected');
            this.updateStatus('Connected to Susan');
        };
        
        this.ws.onmessage = (event) => {
            const data = JSON.parse(event.data);
            this.handleServerMessage(data);
        };
        
        this.ws.onclose = () => {
            console.log('WebSocket disconnected');
            this.updateStatus('Disconnected from Susan');
            
            // Attempt to reconnect after 3 seconds
            setTimeout(() => this.initWebSocket(), 3000);
        };
        
        this.ws.onerror = (error) => {
            console.error('WebSocket error:', error);
            this.updateStatus('Connection error');
        };
    }
    
    bindEvents() {
        console.log('Binding events...');
        
        // Orb interactions
        if (this.susanOrb) {
            console.log('✅ Binding click event to Susan Orb');
            this.susanOrb.addEventListener('click', () => {
                console.log('Orb clicked - handling interaction');
                if (this.isListening) {
                    this.stopListening();
                } else {
                    this.startListening();
                }
                if (this.isSpeaking) {
                    this.synthesis.cancel();
                }
            });
        } else {
            console.log('❌ Susan Orb element not found for binding');
        }
        
        // Voice controls
        if (this.voiceBtn) {
            console.log('✅ Binding click event to Voice Button');
            this.voiceBtn.addEventListener('click', (event) => {
                console.log('Voice button clicked');
                // Enhanced voice recording with Whisper support
                if (event.shiftKey) {
                    console.log('Using browser speech recognition (Shift+Click)');
                    this.startListening(); // Browser speech recognition
                } else {
                    console.log('Using Whisper recording');
                    this.startAdvancedVoiceRecording(); // Try Whisper first
                }
            });
        } else {
            console.log('❌ Voice Button element not found for binding');
        }
        
        this.stopBtn?.addEventListener('click', () => {
            this.stopListening();
            this.stopAdvancedVoiceRecording();
        });
        
        // Text input
        if (this.sendBtn) {
            console.log('✅ Binding click event to Send Button');
            this.sendBtn.addEventListener('click', () => {
                console.log('Send button clicked');
                this.sendTextMessage();
            });
        } else {
            console.log('❌ Send Button element not found for binding');
        }
        
        if (this.textInput) {
            console.log('✅ Binding keypress event to Text Input');
            this.textInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter' && !e.shiftKey) {
                    console.log('Enter key pressed - sending message');
                    e.preventDefault();
                    this.sendTextMessage();
                }
            });
        } else {
            console.log('❌ Text Input element not found for binding');
        }
        
        // Navigation
        this.themeToggle?.addEventListener('click', () => this.toggleTheme());
        this.settingsBtn?.addEventListener('click', () => this.openSettings());
        this.closeSettings?.addEventListener('click', () => this.closeSettingsPanel());
        this.fullscreenBtn?.addEventListener('click', () => this.toggleFullscreen());
        this.clearChat?.addEventListener('click', () => this.clearChatHistory());
        
        // File handling
        this.attachBtn?.addEventListener('click', () => this.fileInput?.click());
        this.fileInput?.addEventListener('change', (e) => this.handleFileSelect(e));
        
        // Drop zone functionality with command input
        if (this.dropZone) {
            this.dropZone.addEventListener('click', () => this.fileInput?.click());
            
            this.dropZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                this.dropZone.classList.add('drag-over');
                // Show command input when dragging files
                const commandContainer = document.getElementById('uploadCommandContainer');
                if (commandContainer) {
                    commandContainer.style.display = 'block';
                }
            });
            
            this.dropZone.addEventListener('dragleave', () => {
                this.dropZone.classList.remove('drag-over');
            });
            
            this.dropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                this.dropZone.classList.remove('drag-over');
                const files = Array.from(e.dataTransfer.files);
                this.handleFileSelect({ target: { files: files } });
            });
        }
        
        // Settings
        this.voiceSpeedSlider?.addEventListener('input', (e) => this.updateVoiceSpeed(e.target.value));
        this.voicePitchSlider?.addEventListener('input', (e) => this.updateVoicePitch(e.target.value));
        this.animationsToggle?.addEventListener('change', (e) => this.toggleAnimations(e.target.checked));
        this.particlesToggle?.addEventListener('change', (e) => this.toggleParticles(e.target.checked));
        
        // Features menu button
        const featuresBtn = document.getElementById('featuresBtn');
        if (featuresBtn) {
            console.log('✅ Binding click event to Features Button');
            featuresBtn.addEventListener('click', () => {
                console.log('Features button clicked');
                this.showFeaturesMenu();
            });
        } else {
            console.log('❌ Features Button element not found for binding');
        }
        
        // Keyboard shortcuts
        document.addEventListener('keydown', (e) => this.handleKeyboard(e));
        
        // Drag and drop
        this.setupDragAndDrop();
    }
    
    startListening() {
        if (!this.recognition) {
            this.updateStatus('Speech recognition not available');
            this.showNotification('Voice Recognition', 'Not available in this browser', 'warning');
            return;
        }
        
        // Check if already listening
        if (this.isListening) {
            console.log('Already listening, ignoring start request');
            return;
        }
        
        if (this.isSpeaking) {
            this.synthesis.cancel();
        }
        
        try {
            console.log('Starting speech recognition...');
            this.recognition.start();
        } catch (error) {
            console.error('Failed to start recognition:', error);
            
            // Handle specific errors
            if (error.name === 'InvalidStateError') {
                console.log('Recognition already active, stopping and restarting...');
                this.recognition.abort();
                setTimeout(() => {
                    if (!this.isListening) {
                        this.startListening();
                    }
                }, 100);
            } else {
                this.updateStatus('Failed to start listening');
                this.showNotification('Voice Error', 'Failed to start voice recognition', 'error');
            }
        }
    }
    
    stopListening() {
        console.log('Stopping speech recognition...');
        this.isListening = false;
        this.susanOrb?.classList.remove('listening');
        
        if (this.voiceBtn) {
            this.voiceBtn.innerHTML = `
                <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                    <line x1="12" y1="19" x2="12" y2="23"/>
                    <line x1="8" y1="23" x2="16" y2="23"/>
                </svg>
                <span class="btn-text">Talk to Susan</span>
            `;
            this.voiceBtn.disabled = false;
        }
        
        // Safely stop recognition
        if (this.recognition) {
            try {
                this.recognition.abort();
            } catch (error) {
                console.log('Error stopping recognition (safe to ignore):', error.message);
            }
        }
        
        this.stopAudioVisualization();
        this.updateStatus('Ready');
    }
    
    // Enhanced voice recording with Whisper support
    async startAdvancedVoiceRecording() {
        // Check if already recording
        if (this.isListening || (this.mediaRecorder && this.mediaRecorder.state === 'recording')) {
            console.log('Already recording, ignoring start request');
            return;
        }
        
        try {
            console.log('Starting advanced voice recording...');
            this.updateStatus('Requesting microphone access...');
            
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                throw new Error('MediaDevices API not supported');
            }
            
            let stream;
            try {
                stream = await navigator.mediaDevices.getUserMedia({ 
                    audio: {
                        channelCount: 1,
                        sampleRate: 16000,
                        echoCancellation: true,
                        noiseSuppression: true
                    }
                });
            } catch (error) {
                console.log('Trying fallback audio constraints...');
                stream = await navigator.mediaDevices.getUserMedia({ audio: true });
            }
            
            this.updateStatus('Setting up recorder...');
            
            let mimeType = 'audio/webm;codecs=opus';
            const supportedTypes = [
                'audio/webm;codecs=opus',
                'audio/webm',
                'audio/mp4',
                'audio/wav'
            ];
            
            for (const type of supportedTypes) {
                if (MediaRecorder.isTypeSupported(type)) {
                    mimeType = type;
                    break;
                }
            }
            
            this.mediaRecorder = new MediaRecorder(stream, { mimeType });
            this.audioChunks = [];
            
            this.mediaRecorder.ondataavailable = (event) => {
                if (event.data.size > 0) {
                    this.audioChunks.push(event.data);
                }
            };
            
            this.mediaRecorder.onstop = async () => {
                const audioBlob = new Blob(this.audioChunks, { type: mimeType });
                if (audioBlob.size > 0) {
                    await this.sendAudioToWhisper(audioBlob);
                }
                stream.getTracks().forEach(track => track.stop());
                this.audioChunks = [];
                this.resetVoiceButton();
            };
            
            this.mediaRecorder.start(1000);
            this.isListening = true;
            this.susanOrb?.classList.add('listening');
            this.updateStatus('Recording with Whisper...');
            
            if (this.voiceBtn) {
                this.voiceBtn.innerHTML = `
                    <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="3"/>
                    </svg>
                    <span class="btn-text">Recording...</span>
                `;
                this.voiceBtn.disabled = true;
            }
            
            // Auto-stop after 10 seconds
            setTimeout(() => {
                if (this.isListening && this.mediaRecorder?.state === 'recording') {
                    this.stopAdvancedVoiceRecording();
                }
            }, 10000);
            
        } catch (error) {
            console.error('Advanced voice recording failed:', error);
            this.updateStatus('Recording failed');
            this.showNotification('Voice Error', 'Failed to start recording. Using fallback...', 'warning');
            this.resetVoiceButton();
            
            // Fallback to browser speech recognition
            setTimeout(() => this.startListening(), 1000);
        }
    }
    
    stopAdvancedVoiceRecording() {
        if (this.mediaRecorder && this.mediaRecorder.state === 'recording') {
            this.mediaRecorder.stop();
            this.isListening = false;
            this.susanOrb?.classList.remove('listening');
            this.updateStatus('Processing audio...');
        }
    }
    
    async sendAudioToWhisper(audioBlob) {
        try {
            const formData = new FormData();
            formData.append('audio', audioBlob, 'recording.webm');
            
            this.updateStatus('Transcribing with Whisper...');
            
            const response = await fetch('/api/v1/voice/transcribe', {
                method: 'POST',
                body: formData
            });
            
            if (!response.ok) {
                throw new Error(`Transcription failed: ${response.status}`);
            }
            
            const result = await response.json();
            
            if (result.success && result.text && result.text.trim()) {
                console.log('Whisper transcription:', result.text);
                this.updateStatus('Processing your request...');
                this.processUserInput(result.text.trim());
                this.addActivity(`Whisper: "${result.text.substring(0, 30)}..."`, 'voice');
                this.showNotification('Voice Recognition', 'Message transcribed successfully', 'success');
            } else {
                throw new Error('No text transcribed');
            }
            
        } catch (error) {
            console.error('Whisper transcription error:', error);
            this.updateStatus('Transcription failed');
            this.showNotification('Transcription Error', 'Using fallback recognition...', 'warning');
            
            // Fallback to browser speech recognition
            setTimeout(() => this.startListening(), 500);
        } finally {
            this.resetVoiceButton();
        }
    }
    
    resetVoiceButton() {
        if (this.voiceBtn) {
            this.voiceBtn.innerHTML = `
                <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                    <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                    <line x1="12" y1="19" x2="12" y2="23"/>
                    <line x1="8" y1="23" x2="16" y2="23"/>
                </svg>
                <span class="btn-text">Talk to Susan</span>
            `;
            this.voiceBtn.disabled = false;
        }
    }
    
    sendTextMessage() {
        const message = this.textInput.value.trim();
        if (message) {
            this.processUserInput(message);
            this.textInput.value = '';
        }
    }
    
    processUserInput(input) {
        if (!input) return;
        
        this.addMessage(input, 'user');
        
        // Intelligent Feature Detection - Check if user is asking for a specific feature
        const detectedFeature = this.detectFeatureRequest(input);
        if (detectedFeature) {
            this.handleFeatureRequest(detectedFeature, input);
            return;
        }
        
        this.showTypingIndicator();
        this.setThinkingState(true);
        
        // Store the input for potential contextual suggestions after AI responds
        this.lastUserInput = input;
        
        if (this.ws && this.ws.readyState === WebSocket.OPEN) {
            this.ws.send(JSON.stringify({
                type: 'message',
                content: input,
                timestamp: new Date().toISOString()
            }));
        } else {
            this.hideTypingIndicator();
            this.setThinkingState(false);
            this.addMessage('Sorry, I\'m not connected right now. Please try again.', 'susan');
        }
        
        this.stopListening();
    }
    
    // ====== CONVERSATIONAL FEATURE DETECTION SYSTEM ======
    
    detectFeatureRequest(input) {
        const inputLower = input.toLowerCase();
        
        // Define feature detection patterns with their corresponding functions
        const featurePatterns = {
            // Photo & Analysis Features
            'photo-analysis': {
                patterns: ['analyze photo', 'analyze this photo', 'photo analysis', 'damage analysis', 'roof analysis', 'analyze image', 'analyze this image', 'look at this photo', 'what do you see', 'assess damage'],
                function: 'startSmartPhotoAnalysis',
                description: 'AI-powered photo analysis for roof damage assessment'
            },
            'damage-quantification': {
                patterns: ['count damage', 'quantify damage', 'damage quantification', 'count impacts', 'hail count', 'impact count', 'measure damage', 'damage measurement'],
                function: 'startDamageQuantification', 
                description: 'Count and measure damage impacts per square foot'
            },
            'photo-report': {
                patterns: ['photo report', 'generate report', 'create report', 'photo documentation', 'damage report', 'inspection report'],
                function: 'startPhotoReportGeneration',
                description: 'Generate professional photo reports'
            },
            'before-after': {
                patterns: ['before after', 'compare photos', 'photo comparison', 'before and after', 'comparison tool'],
                function: 'startBeforeAfter',
                description: 'Compare before and after photos'
            },
            
            // Claims & Documentation
            'claim-tracking': {
                patterns: ['track claim', 'claim tracking', 'claim dashboard', 'claim status', 'my claims', 'track my claim', 'claim progress'],
                function: 'startClaimTracking',
                description: 'Track and manage insurance claims'
            },
            'insurance-forms': {
                patterns: ['insurance forms', 'insurance documents', 'claim forms', 'insurance paperwork', 'forms', 'insurance documentation'],
                function: 'startInsuranceForms',
                description: 'Generate insurance forms and documents'
            },
            'estimate-builder': {
                patterns: ['create estimate', 'build estimate', 'estimate builder', 'cost estimate', 'pricing estimate', 'estimate tool'],
                function: 'startEstimateBuilder',
                description: 'Build detailed cost estimates'
            },
            'claim-templates': {
                patterns: ['claim template', 'claim templates', 'insurance template', 'damage template', 'report template'],
                function: 'startClaimTemplates',
                description: 'Access claim and damage templates'
            },
            
            // Measurement & Calculation
            'roof-measurement': {
                patterns: ['measure roof', 'roof measurement', 'roof area', 'square footage', 'roof size', 'calculate roof area'],
                function: 'startRoofMeasurement',
                description: 'Measure roof areas and dimensions'
            },
            'material-calculator': {
                patterns: ['calculate materials', 'material calculator', 'material estimate', 'shingles needed', 'materials needed'],
                function: 'startMaterialCalculator',
