    addReportPhotos() {
        const input = document.createElement('input');
        input.type = 'file';
        input.multiple = true;
        input.accept = 'image/*';
        
        input.addEventListener('change', (e) => {
            const files = Array.from(e.target.files);
            this.addPhotosToReport(files);
        });
        
        input.click();
    }

    addPhotosToReport(files) {
        const photoGrid = document.getElementById('reportPhotoGrid');
        
        // Clear placeholder
        photoGrid.innerHTML = '';
        
        files.forEach((file, index) => {
            const photoItem = document.createElement('div');
            photoItem.className = 'photo-item';
            photoItem.innerHTML = `
                <div class="photo-thumbnail">
                    <img src="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='100' viewBox='0 0 150 100'><rect width='150' height='100' fill='%23e5e5e5'/><text x='75' y='50' text-anchor='middle' dy='.3em' fill='%23666'>Photo ${index + 1}</text></svg>" alt="Report photo">
                </div>
                <div class="photo-info">
                    <span class="photo-name">${file.name}</span>
                    <button onclick="this.parentElement.parentElement.remove()">Remove</button>
                </div>
            `;
            photoGrid.appendChild(photoItem);
        });
        
        this.showNotification('Photos Added', `Added ${files.length} photos to report`, 'success');
    }

