    // Smart Photo Analysis Implementation
    startSmartPhotoAnalysis() {
        this.hideFeaturesMenu();
        this.openFeatureModal('photoAnalysisModal');
        this.initPhotoAnalysis();
        this.updateStatus('Smart Photo Analysis Active');
    }

    initPhotoAnalysis() {
        const uploadArea = document.getElementById('photoUploadArea');
        const fileInput = document.getElementById('photoUploadInput');
        
        if (uploadArea && fileInput) {
            // Drag and drop functionality
            uploadArea.addEventListener('dragover', (e) => {
                e.preventDefault();
                uploadArea.classList.add('drag-over');
            });
            
            uploadArea.addEventListener('dragleave', () => {
                uploadArea.classList.remove('drag-over');
            });
            
            uploadArea.addEventListener('drop', (e) => {
                e.preventDefault();
                uploadArea.classList.remove('drag-over');
                const files = Array.from(e.dataTransfer.files);
                this.processPhotosForAnalysis(files);
            });
            
            fileInput.addEventListener('change', (e) => {
                const files = Array.from(e.target.files);
                this.processPhotosForAnalysis(files);
            });
        }
    }

    async processPhotosForAnalysis(files) {
        const resultsContainer = document.getElementById('photoAnalysisResults');
        const resultsDiv = resultsContainer.querySelector('.results-container');
        
        resultsContainer.style.display = 'block';
        resultsDiv.innerHTML = '';
        
        // Process each file with real AI analysis
        for (let index = 0; index < files.length; index++) {
            const file = files[index];
            const resultItem = document.createElement('div');
            resultItem.className = 'analysis-result-item';
            
            // Show loading state
            resultItem.innerHTML = `
                <div class="result-photo">
                    <img src="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100' viewBox='0 0 100 100'><rect width='100' height='100' fill='%23f0f0f0'/><text x='50' y='50' text-anchor='middle' dy='.3em' fill='%23666'>Analyzing...</text></svg>" alt="Analyzing photo">
                </div>
                <div class="result-details">
                    <h4>${file.name}</h4>
                    <div class="analysis-status">
                        <span class="status-text">🔍 Analyzing with AI...</span>
                    </div>
                </div>
            `;
            
            resultsDiv.appendChild(resultItem);
            
            // Perform real AI analysis
            try {
                const analysis = await this.analyzePhotoWithAI(file);
                
                // Update with real results
                resultItem.innerHTML = `
                    <div class="result-photo">
                        <img src="${URL.createObjectURL(file)}" alt="Analyzed photo" style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px;">
                    </div>
                    <div class="result-details">
                        <h4>${file.name}</h4>
                        <div class="damage-detected">
                            <span class="damage-type">${analysis.damageType}</span>
                            <span class="severity ${analysis.severity.toLowerCase()}">${analysis.severity} Severity</span>
                        </div>
                        <div class="confidence-score">
                            <span>Confidence: ${analysis.confidence}%</span>
                            <div class="confidence-bar">
                                <div class="confidence-fill" style="width: ${analysis.confidence}%"></div>
                            </div>
                        </div>
                        <div class="analysis-details">
                            <p>${analysis.description}</p>
                        </div>
                        <div class="analysis-actions">
                            <button onclick="susan.markDamageArea('${file.name}')">Mark Damage</button>
                            <button onclick="susan.exportAnalysis('${file.name}')">Export</button>
                        </div>
                    </div>
                `;
            } catch (error) {
                console.error('Analysis failed for', file.name, error);
                resultItem.innerHTML = `
                    <div class="result-photo">
                        <img src="${URL.createObjectURL(file)}" alt="Photo" style="width: 100px; height: 100px; object-fit: cover; border-radius: 8px;">
                    </div>
                    <div class="result-details">
                        <h4>${file.name}</h4>
                        <div class="analysis-error">
                            <span class="error-text">❌ Analysis failed</span>
                            <p>Unable to analyze this image. Please try again or contact support.</p>
                        </div>
                        <div class="analysis-actions">
                            <button onclick="susan.retryAnalysis('${file.name}')">Retry</button>
                        </div>
                    </div>
                `;
            }
        }
        
        this.showNotification('Photo Analysis', `Analyzed ${files.length} photos successfully`, 'success');
    }

    // Damage Quantification Tool Implementation
    initDamageQuantificationTool() {
        this.damageCount = 0;
        this.updateDamageQuantificationDisplay();
        
        // Set today's date as default for inspection
        const today = new Date().toISOString().split('T')[0];
        const inspectionDateInput = document.getElementById('inspectionDate');
        if (inspectionDateInput) {
            inspectionDateInput.value = today;
        }
    }

    addImpact() {
        this.damageCount++;
        this.updateDamageQuantificationDisplay();
        this.addActivity(`Impact count increased to ${this.damageCount}`, 'tool');
    }

    removeImpact() {
        if (this.damageCount > 0) {
            this.damageCount--;
            this.updateDamageQuantificationDisplay();
        }
    }

    resetCount() {
        this.damageCount = 0;
        this.updateDamageQuantificationDisplay();
        this.showNotification('Counter Reset', 'Impact count has been reset to zero', 'info');
    }

    // AI-Powered Auto-Quantification
    async autoQuantifyDamage() {
        const input = document.createElement('input');
        input.type = 'file';
        input.accept = 'image/*';
        
        input.addEventListener('change', async (e) => {
            const file = e.target.files[0];
            if (!file) return;
            
            try {
                this.showNotification('AI Quantification', 'Analyzing damage with AI...', 'info');
                
                // Convert file to base64
                const base64 = await this.fileToBase64(file);
                const area = parseFloat(document.getElementById('measurementArea')?.value) || 100;
                
                // Send to AI quantification endpoint
                const response = await fetch('/api/quantify-damage', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        image: base64,
                        filename: file.name,
                        area: area
                    })
                });
                
                if (!response.ok) {
                    throw new Error(`Quantification failed: ${response.status}`);
                }
                
                const result = await response.json();
                
                if (result.success) {
                    // Update damage count with AI results
                    this.damageCount = result.quantification.totalImpacts;
                    this.updateDamageQuantificationDisplay();
                    
                    // Show detailed AI results
                    this.showQuantificationResults(result.quantification);
                    
                    this.showNotification('AI Quantification Complete', 
                        `Found ${result.quantification.totalImpacts} impacts with ${result.quantification.confidence}% confidence`, 
                        'success');
                        
                    this.addActivity(`AI quantified ${result.quantification.totalImpacts} impacts (${result.quantification.severity} severity)`, 'ai');
                } else {
                    throw new Error(result.error || 'Quantification failed');
                }
                
            } catch (error) {
                console.error('AI Quantification error:', error);
                this.showNotification('Quantification Failed', `Error: ${error.message}`, 'error');
            }
        });
        
        input.click();
    }

    showQuantificationResults(quantification) {
        const resultsHtml = `
            <div class="ai-quantification-results" style="background: #f8f9fa; padding: 20px; border-radius: 10px; margin: 15px 0; border-left: 4px solid #007bff;">
                <h4 style="margin-bottom: 15px; color: #007bff;">🤖 AI Quantification Results</h4>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 15px;">
                    <div style="background: white; padding: 15px; border-radius: 8px;">
                        <strong>Total Impacts</strong><br>
                        <span style="font-size: 1.5em; color: #dc3545;">${quantification.totalImpacts}</span>
                    </div>
                    <div style="background: white; padding: 15px; border-radius: 8px;">
                        <strong>Severity Level</strong><br>
                        <span style="font-size: 1.2em; color: #28a745;">${quantification.severity}</span>
                    </div>
                    <div style="background: white; padding: 15px; border-radius: 8px;">
                        <strong>Confidence</strong><br>
                        <span style="font-size: 1.2em; color: #17a2b8;">${quantification.confidence}%</span>
                    </div>
                    <div style="background: white; padding: 15px; border-radius: 8px;">
                        <strong>Claim Viability</strong><br>
                        <span style="font-size: 1.2em; color: #fd7e14;">${quantification.claimViability}</span>
                    </div>
                </div>
                
                ${quantification.impactsBySize ? `
                <div style="background: white; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
                    <strong>Impact Distribution:</strong><br>
                    Small (&lt;1"): ${quantification.impactsBySize.small} | 
                    Medium (1-2"): ${quantification.impactsBySize.medium} | 
                    Large (&gt;2"): ${quantification.impactsBySize.large}
                </div>
                ` : ''}
                
                ${quantification.areaAnalysis ? `
                <div style="background: white; padding: 15px; border-radius: 8px; margin-bottom: 15px;">
                    <strong>Area Analysis:</strong><br>
                    Impacts per sq ft: ${quantification.areaAnalysis.impactsPerSqFt}<br>
                    Damage coverage: ${quantification.areaAnalysis.damagePercentage}%
                </div>
                ` : ''}
                
                <div style="background: white; padding: 15px; border-radius: 8px;">
                    <strong>Recommendation:</strong> ${quantification.repairRecommendation}<br>
                    <strong>Urgency:</strong> ${quantification.urgency}
                </div>
                
                ${quantification.detailedFindings && quantification.detailedFindings.length > 0 ? `
                <div style="background: white; padding: 15px; border-radius: 8px; margin-top: 15px;">
                    <strong>Key Findings:</strong>
                    <ul style="margin-top: 8px;">
                        ${quantification.detailedFindings.map(finding => `<li style="margin: 5px 0;">${finding}</li>`).join('')}
                    </ul>
                </div>
                ` : ''}
            </div>
        `;
        
        // Insert results after the controls
        const damageModal = document.querySelector('#damageQuantificationModal .modal-content');
        if (damageModal) {
            // Remove any existing results
            const existingResults = damageModal.querySelector('.ai-quantification-results');
            if (existingResults) {
                existingResults.remove();
            }
            
            // Add new results after the form controls
            const formSection = damageModal.querySelector('.quantification-form') || damageModal;
            formSection.insertAdjacentHTML('afterend', resultsHtml);
        }
    }

    updateDamageQuantificationDisplay() {
        const area = parseFloat(document.getElementById('measurementArea')?.value) || 100;
        const impactsPerSqFt = (this.damageCount / area).toFixed(1);
        const percentage = Math.min((this.damageCount / area) * 10, 100).toFixed(0);
        
        // Update display elements
        const elements = {
            'impactCount': this.damageCount,
            'impactsPerSqFt': impactsPerSqFt,
            'damagePercentage': `${percentage}%`,
            'totalImpacts': this.damageCount
        };
        
        Object.entries(elements).forEach(([id, value]) => {
            const element = document.getElementById(id);
            if (element) element.textContent = value;
        });
        
        // Update assessment results
        const density = impactsPerSqFt < 3 ? 'Low' : impactsPerSqFt < 8 ? 'Moderate' : 'High';
        const action = density === 'Low' ? 'Monitor' : density === 'Moderate' ? 'Repair Recommended' : 'Immediate Repair Required';
        
        const densityElement = document.getElementById('damageDensity');
        const actionElement = document.getElementById('recommendedAction');
        
        if (densityElement) densityElement.textContent = density;
        if (actionElement) actionElement.textContent = action;
    }

    // Photo Report Generator Implementation
    initPhotoReportGenerator() {
        // Set today's date as default
        const today = new Date().toISOString().split('T')[0];
        const inspectionDateInput = document.getElementById('inspectionDate');
        if (inspectionDateInput) {
            inspectionDateInput.value = today;
        }
