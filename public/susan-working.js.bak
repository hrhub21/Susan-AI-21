    handleKeyboard(e) {
        // Space to start/stop listening
        if (e.code === 'Space' && e.target === document.body) {
            e.preventDefault();
            if (this.isListening) {
                this.stopListening();
                this.stopAdvancedVoiceRecording();
            } else {
                this.startAdvancedVoiceRecording();
            }
        }
        
        // Escape to stop everything
        if (e.code === 'Escape') {
            this.stopListening();
            this.stopAdvancedVoiceRecording();
            this.synthesis.cancel();
        }
    }
    
