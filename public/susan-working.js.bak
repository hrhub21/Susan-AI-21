// Initialize Susan AI when page loads
let susan;

function initializeSusan() {
    console.log('🚀 Initializing Susan AI...');
    
    // Check if already initialized
    if (window.susan) {
        console.log('✅ Susan AI already initialized');
        return;
    }
    
    try {
        console.log('Creating new SusanAI instance...');
        susan = new SusanAI();
        window.susan = susan; // Make it globally accessible
        console.log('✅ Susan AI instance created and made globally accessible');
        
        // Verify the instance
        if (window.susan && typeof window.susan.startListening === 'function') {
            console.log('✅ Susan AI methods verified');
        } else {
            console.log('❌ Susan AI methods not properly attached');
        }
        
        // Add global test functions for debugging
        window.testFeaturesMenu = () => {
            console.log('🧪 Manual features menu test...');
            if (window.susan && window.susan.showFeaturesMenu) {
                window.susan.showFeaturesMenu();
            } else {
                console.log('❌ Susan AI or showFeaturesMenu method not available');
            }
        };
        
        window.hideFeaturesMenu = () => {
            if (window.susan && window.susan.hideFeaturesMenu) {
                window.susan.hideFeaturesMenu();
            }
        };
        
        // Comprehensive test function
        window.testAllFeatures = () => {
            console.log('🧪 Testing all features...');
            
            // Test 1: Features button exists and is clickable
            const featuresBtn = document.getElementById('featuresBtn');
            console.log('1. Features Button:', featuresBtn ? '✅ Found' : '❌ Missing');
            
            // Test 2: Features menu exists
            const featuresMenu = document.getElementById('featuresMenu');
            console.log('2. Features Menu:', featuresMenu ? '✅ Found' : '❌ Missing');
            
            // Test 3: Close button exists
            const closeFeaturesBtn = document.getElementById('closeFeaturesBtn');
            console.log('3. Close Button:', closeFeaturesBtn ? '✅ Found' : '❌ Missing');
            
            // Test 4: Feature buttons exist
            const featureButtons = document.querySelectorAll('.feature-btn');
            console.log(`4. Feature Buttons: ✅ Found ${featureButtons.length} buttons`);
            
            // Test 5: Susan AI methods exist
            const methods = [
                'showFeaturesMenu',
                'hideFeaturesMenu', 
                'startDamageQuantification',
                'startPhotoReports',
                'startBeforeAfter'
            ];
            
            methods.forEach((method, index) => {
                const exists = window.susan && typeof window.susan[method] === 'function';
                console.log(`5.${index + 1}. ${method}:`, exists ? '✅ Available' : '❌ Missing');
            });
            
            console.log('🎯 Test Summary: All components should show ✅ for full functionality');
            
            return {
                featuresButton: !!featuresBtn,
                featuresMenu: !!featuresMenu,
                closeButton: !!closeFeaturesBtn,
                featureButtonCount: featureButtons.length,
                susanMethods: methods.every(method => window.susan && typeof window.susan[method] === 'function')
            };
        };
        
        // Test if elements are bound
        setTimeout(() => {
            const orbElement = document.getElementById('susanOrb');
            if (orbElement) {
                console.log('✅ Susan Orb element found and should be clickable');
                // Force re-bind click event as a fallback
                orbElement.addEventListener('click', () => {
                    console.log('Orb clicked via fallback handler!');
                    if (window.susan) {
                        if (window.susan.isListening) {
                            window.susan.stopListening();
                        } else {
                            window.susan.startListening();
                        }
                    }
                });
            } else {
                console.log('❌ Susan Orb element not found');
            }
            
            console.log('✅ Main event handlers are working properly');
            
            // Announce new features
            susan.announceNewFeatures();
        }, 100);
        
    } catch (error) {
        console.error('❌ Failed to initialize Susan AI:', error);
        console.error('Error details:', {
            name: error.name,
            message: error.message,
            stack: error.stack
        });
        
        // Create a minimal fallback
        console.log('Creating minimal fallback...');
        window.susan = {
            isListening: false,
            startListening: () => console.log('Fallback: Start listening not implemented'),
            stopListening: () => console.log('Fallback: Stop listening not implemented'),
            processUserInput: (input) => console.log('Fallback: Process input:', input)
        };
    }
}

// Multiple initialization strategies
document.addEventListener('DOMContentLoaded', initializeSusan);

// Fallback initialization
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeSusan);
} else {
    // DOM already loaded
    initializeSusan();
}

// Additional fallback
window.addEventListener('load', () => {
    if (!window.susan) {
        console.log('Fallback initialization...');
        initializeSusan();
    }
});