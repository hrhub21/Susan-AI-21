    async handleFileSelect(e) {
        const files = Array.from(e.target.files);
        if (files.length === 0) return;
        
        console.log('Files selected for analysis:', files);
        
        for (const file of files) {
            await this.analyzeUploadedFile(file);
        }
        
        // Clear the input for future uploads
        e.target.value = '';
    }
    
    async convertHeicToJpeg(heicFile) {
        // For HEIC conversion, we'll use a canvas-based approach
        // Note: This is a simplified version - in production you might want to use heic2any library
        return new Promise((resolve, reject) => {
            const canvas = document.createElement('canvas');
            const ctx = canvas.getContext('2d');
            const img = new Image();
            
            img.onload = function() {
                canvas.width = img.width;
                canvas.height = img.height;
                ctx.drawImage(img, 0, 0);
                
                canvas.toBlob((blob) => {
                    if (blob) {
                        // Create a new File object with JPEG type
                        const jpegFile = new File([blob], heicFile.name.replace(/\.heic$/i, '.jpg'), {
                            type: 'image/jpeg',
                            lastModified: heicFile.lastModified
                        });
                        resolve(jpegFile);
                    } else {
                        reject(new Error('Failed to convert HEIC to JPEG'));
                    }
                }, 'image/jpeg', 0.9);
            };
            
            img.onerror = () => {
                reject(new Error('Failed to load HEIC image'));
            };
            
            // Try to load the HEIC file as an image (modern browsers may support it)
            const url = URL.createObjectURL(heicFile);
            img.src = url;
            
            // Cleanup after 30 seconds
            setTimeout(() => {
                URL.revokeObjectURL(url);
            }, 30000);
        });
    }
    
    async analyzeUploadedFile(file) {
        try {
            this.updateStatus(`📄 Analyzing ${file.name}...`);
            
            // Check for upload command
            const uploadCommand = document.getElementById('uploadCommand')?.value || '';
            
            // Check if file is an image (including HEIC)
            const isImage = file.type && file.type.startsWith('image/') || 
                           file.name.toLowerCase().endsWith('.heic') || 
                           file.name.toLowerCase().endsWith('.HEIC');
                           
            // Handle HEIC conversion if needed
            let processedFile = file;
            if (file.name.toLowerCase().includes('.heic')) {
                try {
                    processedFile = await this.convertHeicToJpeg(file);
                    this.showNotification('HEIC Conversion', 'iPhone image converted successfully', 'success');
                } catch (heicError) {
                    console.warn('HEIC conversion failed, trying direct upload:', heicError);
                    // Continue with original file if conversion fails
                }
            }
            
            if (isImage) {
                // Route images to photo analysis endpoint with Qwen2.5-VL
                this.updateStatus(`🖼️ Analyzing image ${file.name} with AI...`);
                this.showNotification('Photo Analysis', `Analyzing ${file.name} for roofing damage...`, 'info');
                
                // Convert to base64 for photo analysis
                const base64 = await this.fileToBase64(file);
                
                const response = await fetch('/api/analyze-photo', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        image: base64,
                        filename: file.name,
                        fileType: file.type
                    })
                });
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const analysis = await response.json();
                this.displayPhotoAnalysisResults(analysis, file.name);
                this.updateStatus('✅ Photo analysis complete');
                this.showNotification('Analysis Complete', `${file.name} analyzed successfully`, 'success');
                
                // Process upload command if provided
                if (uploadCommand.trim()) {
                    this.processUploadCommand(uploadCommand, file.name, analysis);
                    // Clear the command input after processing
                    document.getElementById('uploadCommand').value = '';
                    document.getElementById('uploadCommandContainer').style.display = 'none';
                } else {
                    // Auto-suggest related features based on uploaded image
                    this.suggestImageFeatures(file.name, analysis);
                }
                
            } else {
                // Handle documents
                this.showNotification('Document Upload', `Analyzing ${file.name} for Roof-ER guidance...`, 'info');
                
                // Convert document to base64 for JSON API
                const base64 = await this.fileToBase64(file);
                
                // Upload and analyze document
                const response = await fetch('/api/v1/documents/analyze', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        document: base64,
                        filename: file.name,
                        fileType: file.type
                    })
                });
            
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const analysis = await response.json();
                
                if (analysis.success) {
                    // Display analysis results
                    this.displayDocumentAnalysis(analysis);
                    this.updateStatus('✅ Document analysis complete');
                    this.showNotification('Analysis Complete', `${file.name} analyzed successfully`, 'success');
                    
                    // Auto-suggest related features based on uploaded document
                    this.suggestDocumentFeatures(file.name, analysis);
                } else {
                    throw new Error(analysis.error || 'Analysis failed');
                }
            }
            
        } catch (error) {
            console.error('File analysis error:', error);
            this.updateStatus('❌ Document analysis failed');
            this.showNotification('Analysis Failed', `Could not analyze ${file.name}: ${error.message}`, 'error');
        }
    }
    
    displayDocumentAnalysis(analysis) {
        const timestamp = new Date().toISOString();
        
        // Create analysis message
        const analysisMessage = `📄 **Document Analysis: ${analysis.filename}**

🎯 **Document Type:** ${analysis.analysis.document_type}
📊 **File Size:** ${(analysis.analysis.file_size / 1024).toFixed(1)} KB

${analysis.analysis.susan_guidance.response}

📋 **Recommended Actions:**
${analysis.analysis.recommended_actions.map(action => `• ${action}`).join('\n')}

${analysis.analysis.susan_guidance.escalation?.needed ? 
`⚠️ **Escalation Needed:** ${analysis.analysis.susan_guidance.escalation.reason}
📞 Contact: ${analysis.analysis.susan_guidance.escalation.contact}` : ''}`;

        // Add to chat
        this.addMessage(analysisMessage, 'Susan');
        
        // Update activity log
        this.addActivity(`Analyzed document: ${analysis.filename}`, 'document');
    }
    
    displayPhotoAnalysisResults(analysis, filename) {
        const timestamp = new Date().toISOString();
        
        // Create photo analysis message based on Qwen2.5-VL response format
        let analysisMessage = `📸 **Photo Analysis: ${filename}**\n\n`;
        
        if (analysis.success) {
            // Display damage assessment
            if (analysis.damageType && analysis.damageType !== 'No damage detected') {
                analysisMessage += `🎯 **Damage Type:** ${analysis.damageType}\n`;
                analysisMessage += `⚠️ **Severity:** ${analysis.severity}\n`;
                analysisMessage += `📊 **Confidence:** ${analysis.confidence}%\n\n`;
            } else {
                analysisMessage += `✅ **No Damage Detected**\n`;
                analysisMessage += `📊 **Confidence:** ${analysis.confidence}%\n\n`;
            }
            
            // Display description/analysis
            if (analysis.description) {
                analysisMessage += `📋 **Analysis:**\n${analysis.description}\n\n`;
            }
            
            // Display roof analysis if available
            if (analysis.roofAnalysis) {
                analysisMessage += `🏠 **Roof Assessment:**\n${analysis.roofAnalysis}\n\n`;
            }
            
            // Display recommendations if available
            if (analysis.recommendations && analysis.recommendations.length > 0) {
                analysisMessage += `💡 **Recommendations:**\n`;
                analysisMessage += analysis.recommendations.map(rec => `• ${rec}`).join('\n') + '\n\n';
            }
            
            // Display response if available (from Qwen)
            if (analysis.response && analysis.response !== analysis.description) {
                analysisMessage += `🤖 **AI Assessment:**\n${analysis.response}\n\n`;
            }
            
        } else {
            analysisMessage += `❌ **Analysis Failed**\n`;
            analysisMessage += `Error: ${analysis.error || 'Unknown error occurred'}\n\n`;
        }
        
        analysisMessage += `🔍 **Powered by Qwen2.5-VL AI Vision**`;
        
        // Add to chat
        this.addMessage(analysisMessage, 'Susan');
        
        // Update activity log
        this.addActivity(`Analyzed photo: ${filename}`, 'photo');
    }
    
    processUploadCommand(command, filename, analysis) {
        console.log(`🎯 Processing upload command: "${command}" for ${filename}`);
        
        // Add a message to chat explaining what's happening
        this.addMessage(`🎯 **Processing your request:** "${command}" for ${filename}`, 'Susan');
        
        // Use existing feature detection logic
        const detectedFeature = this.detectFeatureIntent(command);
        
        if (detectedFeature) {
            this.addMessage(`✨ I understand you want ${detectedFeature.description}. Opening that tool now!`, 'Susan');
            
            // Execute the feature
            setTimeout(() => {
                if (typeof this[detectedFeature.action] === 'function') {
                    this[detectedFeature.action]();
                    
                    // Provide context about the uploaded file
                    setTimeout(() => {
                        this.addMessage(`📁 **Context**: I've analyzed ${filename} and found: ${analysis.damageType || 'completed analysis'}. The tool is now ready for your specific request.`, 'Susan');
                    }, 1000);
                } else {
                    this.addMessage(`⚠️ Sorry, I couldn't execute "${detectedFeature.action}". This might be a temporary issue.`, 'Susan');
                }
            }, 500);
            
        } else {
            // Provide helpful guidance if command wasn't recognized
            this.addMessage(`🤔 I didn't recognize the command "${command}". Here are some examples you can try:
            
• "analyze for hail damage"
• "quantify damage impacts" 
• "create estimate"
• "generate report"
• "measure roof"
• "track claim"

Try one of these with your next upload!`, 'Susan');
        }
    }
    
    formatTimestamp(date) {
        return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }
    
    timeAgo(timestamp) {
        const seconds = Math.floor((Date.now() - timestamp) / 1000);
        if (seconds < 60) return 'Just now';
        const minutes = Math.floor(seconds / 60);
        if (minutes < 60) return `${minutes}m ago`;
        const hours = Math.floor(minutes / 60);
        return `${hours}h ago`;
    }
    
    setupSpeechSynthesisUnlock() {
        // Modern browsers require user interaction before allowing speech synthesis
        const unlockSpeech = () => {
            console.log('Unlocking speech synthesis...');
            
            // Create a silent utterance to unlock speech synthesis
            const testUtterance = new SpeechSynthesisUtterance('');
            testUtterance.volume = 0;
            testUtterance.onend = () => {
                console.log('✅ Speech synthesis unlocked');
                this.speechSynthesisUnlocked = true;
                this.showNotification('Voice Ready', 'Susan can now speak responses', 'success');
            };
            
            try {
                this.synthesis.speak(testUtterance);
            } catch (error) {
                console.log('Speech synthesis unlock failed:', error);
            }
            
            // Remove the listener after first use
            document.removeEventListener('click', unlockSpeech);
            document.removeEventListener('keydown', unlockSpeech);
            document.removeEventListener('touchstart', unlockSpeech);
        };
        
        // Listen for any user interaction to unlock speech
        document.addEventListener('click', unlockSpeech, { once: true });
        document.addEventListener('keydown', unlockSpeech, { once: true });
        document.addEventListener('touchstart', unlockSpeech, { once: true });
        
        console.log('Speech synthesis unlock listeners added');
    }
    
