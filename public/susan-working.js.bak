    // Before/After Comparison Implementation
    initBeforeAfterComparison() {
        this.beforeImage = null;
        this.afterImage = null;
    }

    uploadBeforeImage() {
        const input = document.createElement('input');
        input.type = 'file';
        input.accept = 'image/*';
        
        input.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                this.beforeImage = file;
                this.displayComparisonImage('beforeImageArea', file, 'Before');
            }
        });
        
        input.click();
    }

    uploadAfterImage() {
        const input = document.createElement('input');
        input.type = 'file';
        input.accept = 'image/*';
        
        input.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                this.afterImage = file;
                this.displayComparisonImage('afterImageArea', file, 'After');
                
                // If both images are loaded, show analysis
                if (this.beforeImage && this.afterImage) {
                    this.performComparisonAnalysis();
                }
            }
        });
        
        input.click();
    }

    displayComparisonImage(areaId, file, label) {
        const area = document.getElementById(areaId);
        if (area) {
            area.innerHTML = `
                <div class="comparison-image">
                    <img src="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='300' height='200' viewBox='0 0 300 200'><rect width='300' height='200' fill='%23f0f0f0'/><text x='150' y='100' text-anchor='middle' dy='.3em' fill='%23666'>${label} Image: ${file.name}</text></svg>" alt="${label} image">
                </div>
                <div class="image-info">
                    <span>${file.name}</span>
                    <button onclick="susan.${label.toLowerCase() === 'before' ? 'uploadBeforeImage' : 'uploadAfterImage'}()">Change</button>
                </div>
            `;
        }
    }

    performComparisonAnalysis() {
        const analysisDiv = document.getElementById('comparisonAnalysis');
        if (analysisDiv) {
            analysisDiv.style.display = 'block';
            
            // Simulate AI analysis
            const changeDetected = Math.random() > 0.3 ? 'Significant' : 'Minimal';
            const improvementScore = Math.floor(Math.random() * 40) + 60; // 60-100%
            
            document.getElementById('changeDetected').textContent = changeDetected;
            document.getElementById('improvementScore').textContent = `${improvementScore}%`;
            
            this.showNotification('Analysis Complete', 'Before/after comparison analysis completed', 'success');
        }
    }

